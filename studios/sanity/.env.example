# Copy to .env in this folder (studios/sanity). Values are public: they end up in the studio bundle.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Where "Open preview" points: production site, a preview deploy, or `pnpm dev:sanity` (http://localhost:3000)
SANITY_STUDIO_SITE_URL=http://localhost:3000
# Optional: <host>.sanity.studio when deploying the studio
SANITY_STUDIO_HOSTNAME=
