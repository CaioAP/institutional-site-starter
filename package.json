{
  "name": "institutional-site-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:local": "CONTENT_SOURCE=local nuxt dev",
    "dev:studio": "STUDIO_EDITOR=true CONTENT_SOURCE=local nuxt dev",
    "dev:sanity": "CONTENT_SOURCE=sanity nuxt dev",
    "studio:sanity": "pnpm --filter @starter/sanity-studio dev",
    "seed:sanity": "jiti scripts/sanity-seed.ts",
    "seed:sanity:import": "pnpm --filter @starter/sanity-studio seed:import",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/postgenerate.ts",
    "preview": "node tests/support/static-server.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project nuxt",
    "test:unit": "vitest run --project unit --project nuxt",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test",
    "generate:test": "ANALYTICS_PROVIDER=plausible ANALYTICS_ID=example.com FORM_PROVIDER=endpoint FORM_ENDPOINT=https://forms.example.test/contact pnpm generate",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@nuxt/content": "3.16.2",
    "@nuxt/image": "2.2.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/sitemap": "9.1.0",
    "@sanity/client": "8.10.1",
    "@tailwindcss/vite": "4.3.3",
    "github-slugger": "2.0.0",
    "groq-js": "2.0.0",
    "nuxt": "4.6.2",
    "nuxt-schema-org": "7.0.1",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.6.2",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "2.7.0",
    "nuxt-studio": "1.8.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
