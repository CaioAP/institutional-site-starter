# Copy to .env for local development. Every variable is optional unless noted.
# All of these are read at build time (`pnpm generate`) and end up in the
# static site, so never put secrets here.

# Public URL of the deployed site (canonical links, sitemap, hreflang, OG images).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Where content comes from: local (Markdown/YAML in content/) | sanity
CONTENT_SOURCE=local

# Contact form provider: netlify (Netlify Forms) | endpoint (POST JSON to FORM_ENDPOINT)
FORM_PROVIDER=netlify
# Required when FORM_PROVIDER=endpoint, e.g. https://formspree.io/f/xxxxxxx
FORM_ENDPOINT=

# Analytics, loaded only after cookie consent: none | ga4 | plausible
ANALYTICS_PROVIDER=none
# GA4 measurement ID (G-XXXXXXX) or the Plausible site domain (example.com)
ANALYTICS_ID=
# Plausible script URL, change for self-hosted Plausible
PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Set to false to hide the floating WhatsApp button
WHATSAPP_BUTTON=true
