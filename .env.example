# Copy to .env for local development. Every variable is optional unless noted.
# Never put secrets in NUXT_PUBLIC_* variables: they end up in the client bundle.

# Public URL of the deployed site (canonical links, sitemap, hreflang, OG images).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Where content comes from: local (Markdown/YAML in content/) | sanity
CONTENT_SOURCE=local
