# Copy to .env for local development. Every variable is optional unless noted.
# All of these are read at build time (`pnpm generate`). Except for
# SANITY_API_READ_TOKEN, they can end up in the static site, so never put
# secrets in them.

# Public URL of the deployed site (canonical links, sitemap, hreflang, OG images).
NUXT_PUBLIC_SITE_URL=https://www.example.com

# Where content comes from: sanity (default) | local (Markdown/YAML in content/)
CONTENT_SOURCE=sanity

# Sanity project (see studios/sanity/README.md). Without a project id the site
# reads the sample seed in studios/sanity/seed offline.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# published | drafts (drafts: local preview of unpublished changes, needs the token)
SANITY_PERSPECTIVE=published
# Secret, build time only: private datasets and drafts. Set it in the host's
# environment settings or a git-ignored .env, never in this file.
SANITY_API_READ_TOKEN=

# Contact form provider: netlify (Netlify Forms) | endpoint (POST JSON to FORM_ENDPOINT)
FORM_PROVIDER=netlify
# Required when FORM_PROVIDER=endpoint, e.g. https://formspree.io/f/xxxxxxx
FORM_ENDPOINT=

# Analytics, loaded only after cookie consent: none | ga4 | plausible
ANALYTICS_PROVIDER=none
# GA4 measurement ID (G-XXXXXXX) or the Plausible site domain (example.com)
ANALYTICS_ID=
# Plausible script URL, change for self-hosted Plausible
PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Set to false to hide the floating WhatsApp button
WHATSAPP_BUTTON=true
